# ─── Variables de entorno — Sistema de Gestión de Impresoras ──────────────────
# Copia este archivo como ".env" y ajusta los valores a tu entorno.
# El archivo .env NO debe subirse a control de versiones.

# Rango de red a escanear (CIDR). Si no se define, se usa el valor de config.py.
# Ejemplo: NETWORK_RANGE=10.0.0.0/24
NETWORK_RANGE=192.168.146.0/24

# Modo de Flask: "development" activa debug y recarga automática.
FLASK_ENV=development

# Puerto del servidor Flask (por defecto: 5000)
# FLASK_PORT=5000
